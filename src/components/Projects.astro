<section id="projects" class="px-6 py-20 sm:px-8">
  <div class="navbar-shell">
    <div class="reveal mb-12 max-w-2xl">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-[#d4a373]">Projects</p>
      <h2 class="glow-line text-3xl font-semibold tracking-[-0.06em] text-white sm:text-5xl">Selected work</h2>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <article class="panel reveal rounded-[2rem] p-6 sm:p-8">
        <div class="mb-6 flex items-center justify-between gap-3 text-[0.68rem] uppercase tracking-[0.25em] text-[#d4a373]">
          <span>Data & prediction</span>
          <span>Interactive demo</span>
        </div>

        <h3 class="text-2xl font-semibold text-white">Sistem Prediksi Jumlah Siswa</h3>
        <p class="mt-5 text-slate-200">
          A forecasting simulation designed to estimate future student numbers using historical trend data. The model calculates the average increase from the previous two periods and projects the next value.
        </p>

        <div class="mt-6 rounded-2xl border border-white/10 bg-slate-950/40 p-5">
          <div class="grid gap-4 sm:grid-cols-3">
            <label class="block text-sm text-slate-300">
              <span class="mb-2 block">Year 1</span>
              <input id="year-1" type="number" value="100" class="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-white outline-none ring-0 focus:border-[#d4a373]" />
            </label>
            <label class="block text-sm text-slate-300">
              <span class="mb-2 block">Year 2</span>
              <input id="year-2" type="number" value="125" class="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-white outline-none ring-0 focus:border-[#d4a373]" />
            </label>
            <label class="block text-sm text-slate-300">
              <span class="mb-2 block">Year 3</span>
              <input id="year-3" type="number" value="140" class="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-white outline-none ring-0 focus:border-[#d4a373]" />
            </label>
          </div>

          <button type="button" id="predict-btn" class="mt-6 inline-flex items-center justify-center rounded-full bg-[#d4a373] px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-[#e7ba88]">
            Predict Year 4
          </button>

          <div class="mt-6 rounded-2xl border border-[#d4a373]/30 bg-[#d4a373]/10 p-4 text-slate-100">
            <p class="text-sm uppercase tracking-[0.2em] text-[#d4a373]">Forecast result</p>
            <p class="mt-3 text-3xl font-semibold text-white"><span id="prediction-result">—</span> <span class="text-lg text-slate-300">students</span></p>
            <p class="mt-3 text-sm text-slate-300">The formula uses the average change from the two previous intervals: ((Y3 - Y2) + (Y2 - Y1)) / 2.</p>
          </div>
        </div>
      </article>

      <article class="panel reveal rounded-[2rem] p-6 sm:p-8">
        <div class="mb-6 flex items-center justify-between gap-3 text-[0.68rem] uppercase tracking-[0.25em] text-[#d4a373]">
          <span>Portfolio</span>
          <span>Current project</span>
        </div>

        <h3 class="text-2xl font-semibold text-white">Portfolio Redesign</h3>
        <p class="mt-5 text-slate-200">
          A complete editorial-style portfolio redesign built with Astro and Tailwind CSS, optimized for static hosting and responsive presentation across desktop and mobile devices.
        </p>

        <ul class="mt-6 space-y-3 text-slate-200">
          <li>• Static deployment supported for GitHub Pages</li>
          <li>• Modular layout structure with reusable sections</li>
          <li>• SEO metadata, accessible navigation, and mobile-first design</li>
          <li>• Lightweight, maintainable front-end implementation</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<script is:inline>
  const predictButton = document.getElementById('predict-btn');
  const resultNode = document.getElementById('prediction-result');

  if (predictButton && resultNode) {
    predictButton.addEventListener('click', () => {
      const year1 = Number(document.getElementById('year-1').value);
      const year2 = Number(document.getElementById('year-2').value);
      const year3 = Number(document.getElementById('year-3').value);

      if ([year1, year2, year3].some((value) => Number.isNaN(value))) {
        resultNode.textContent = '—';
        alert('Please complete all year values before forecasting.');
        return;
      }

      const delta1 = year2 - year1;
      const delta2 = year3 - year2;
      const averageIncrease = (delta1 + delta2) / 2;
      const forecast = Math.max(0, Math.round(year3 + averageIncrease));

      resultNode.textContent = forecast;
    });
  }
</script>
