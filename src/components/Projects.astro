<script is:inline>
  const predictButton = document.getElementById('predict-btn');
  const resultNode = document.getElementById('prediction-result');
  const errorNode = document.getElementById('prediction-error');
  const yearInputs = ['year-1', 'year-2', 'year-3'].map((id) => document.getElementById(id));

  if (predictButton && resultNode && errorNode && yearInputs.every(Boolean)) {
    yearInputs.forEach((input) => {
      input.addEventListener('input', () => {
        resultNode.textContent = '—';
        errorNode.textContent = '';
      });
    });

    predictButton.addEventListener('click', () => {
      resultNode.textContent = '—';
      errorNode.textContent = '';
      const values = yearInputs.map((input) => input.valueAsNumber);

      if (yearInputs.some((input, index) => !input.validity.valid || !Number.isSafeInteger(values[index]))) {
        errorNode.textContent = 'Enter a whole number greater than zero in each year field. Values must be within the safe numeric range.';
        return;
      }

      const [year1, year2, year3] = values;
      const delta1 = year2 - year1;
      const delta2 = year3 - year2;
      const averageIncrease = (delta1 + delta2) / 2;
      const forecast = Math.max(0, Math.round(year3 + averageIncrease));

      if (!Number.isSafeInteger(forecast)) {
        errorNode.textContent = 'These values produce a forecast outside the safe numeric range. Use smaller values.';
        return;
      }

      resultNode.textContent = forecast;
    });
  }
</script>
